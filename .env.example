# Template for the .env file that compose.yaml reads. Copy it to .env and put in real passwords:
#   cp .env.example .env
# .env is in .gitignore, so the passwords never reach the repository.

# name of the MySQL user the application connects with
MYSQL_USER=change-me
# password of that user
MYSQL_PASSWORD=change-me-as-well
# password of the MySQL root user
MYSQL_ROOT_PASSWORD=change-me-too
